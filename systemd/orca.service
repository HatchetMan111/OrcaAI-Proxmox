[Unit]
Description=Orca Remote Server (orca serve, headless)
Documentation=https://github.com/stablyai/orca
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orca
Group=orca
WorkingDirectory=/var/lib/orca
Environment=HOME=/var/lib/orca
Environment=ORCA_SERVE_PORT=6768
# Startet /usr/local/bin/orca-serve (vom Installer generiert: Dispatcher direkt
# oder xvfb-run + AppRun-Entry, jeweils mit fester Pairing-Adresse).
ExecStart=/usr/local/bin/orca-serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
